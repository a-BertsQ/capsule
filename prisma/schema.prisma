generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  googleId          String?   @unique
  password          String?   // hashed password
  role              String    @default("student")
  planId            Int?      // Current user plan
  plan              Plan?     @relation(fields: [planId], references: [id])
  subscriptionStatus String?  @default("active") // active, expiring, cancelled, suspended
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  lastBillingDate   DateTime?
  nextBillingDate   DateTime?
  isEmailVerified   Boolean   @default(false)
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  bookings          TutorBooking[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  payments          Payment[]
  invoices          Invoice[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  expires      DateTime
  userAgent    String?  // Browser/device info for device limiting
  createdAt    DateTime @default(now())
}

model Plan {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  priceCents  Int       @default(0)
  interval    String    @default("monthly")
  features    Json?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  users       User[]
  payments    Payment[]
  invoices    Invoice[]
}

model Course {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.Text
  published  Boolean  @default(false)
  authorId   String?
  createdAt  DateTime @default(now())
}

model TutorBooking {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  tutorName  String
  scheduledAt DateTime
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // "email_verification" or "email_change"
  newEmail  String?  // Store new email for email change verification
  expires   DateTime
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([userId])
}

model Payment {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  planId          Int
  amountCents     Int
  status          String   @default("pending") // pending, completed, failed, expired
  paymentMethod   String?  // credit_card, bank_transfer, e-wallet, qris
  paymentGateway  String?  // midtrans, xendit, manual
  externalId      String?  @unique // ID from payment gateway
  externalUrl     String?  // Payment URL from gateway
  paidAt          DateTime?
  expiredAt       DateTime?
  metadata        Json?    // Store additional payment data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invoices        Invoice[]
  
  @@index([userId])
  @@index([status])
  @@index([externalId])
}

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  payment         Payment? @relation(fields: [paymentId], references: [id])
  paymentId       String?
  plan            Plan     @relation(fields: [planId], references: [id])
  planId          Int
  amountCents     Int
  status          String   @default("unpaid") // unpaid, paid, cancelled
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([invoiceNumber])
  @@index([status])
}
